# Required
OPENAI_API_KEY=sk-...
# Public host of this server (ngrok http 3000 → the wss URL it prints)
PUBLIC_WS_URL=wss://your-subdomain.ngrok.app

# Optional — enables clean REST hangup, transfer, and outbound calls
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...
# Where transfer_call sends callers when the model doesn't specify a number
TRANSFER_NUMBER=+1...

PORT=3000
