{
  "name": "twilio-realtime-agents",
  "version": "1.2.0",
  "description": "Provider-agnostic bridge between Twilio Media Streams and realtime speech-to-speech AI APIs (OpenAI Realtime, xAI Grok Voice, Gemini Live). Multi-agent handoffs, Zod tools with execution strategies, mark-based playback tracking, interruption guards, and hold audio — for Node.js voice agents over the phone.",
  "keywords": [
    "twilio",
    "media-streams",
    "realtime",
    "voice",
    "voice-agent",
    "speech-to-speech",
    "openai",
    "openai-realtime",
    "gemini",
    "gemini-live",
    "xai",
    "grok",
    "phone",
    "telephony",
    "ai",
    "agents"
  ],
  "license": "MIT",
  "author": "Yakov Sinwani <yakovsinwani@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "assets"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./openai": {
      "import": {
        "types": "./dist/openai.d.mts",
        "default": "./dist/openai.mjs"
      },
      "require": {
        "types": "./dist/openai.d.cts",
        "default": "./dist/openai.cjs"
      }
    },
    "./xai": {
      "import": {
        "types": "./dist/xai.d.mts",
        "default": "./dist/xai.mjs"
      },
      "require": {
        "types": "./dist/xai.d.cts",
        "default": "./dist/xai.cjs"
      }
    },
    "./gemini": {
      "import": {
        "types": "./dist/gemini.d.mts",
        "default": "./dist/gemini.mjs"
      },
      "require": {
        "types": "./dist/gemini.d.cts",
        "default": "./dist/gemini.cjs"
      }
    },
    "./twilio": {
      "import": {
        "types": "./dist/twilio.d.mts",
        "default": "./dist/twilio.mjs"
      },
      "require": {
        "types": "./dist/twilio.d.cts",
        "default": "./dist/twilio.cjs"
      }
    },
    "./audio": {
      "import": {
        "types": "./dist/audio.d.mts",
        "default": "./dist/audio.mjs"
      },
      "require": {
        "types": "./dist/audio.d.cts",
        "default": "./dist/audio.cjs"
      }
    },
    "./store": {
      "import": {
        "types": "./dist/store.d.mts",
        "default": "./dist/store.mjs"
      },
      "require": {
        "types": "./dist/store.d.cts",
        "default": "./dist/store.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.mts",
        "default": "./dist/testing.mjs"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run build && publint && attw --pack . --profile node16",
    "assets:generate": "tsx scripts/generate-tones.ts",
    "changeset": "changeset",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ws": "^8.21.2"
  },
  "peerDependencies": {
    "@google/genai": "^1.0.0 || ^2.0.0",
    "twilio": "^5.0.0 || ^6.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@google/genai": {
      "optional": true
    },
    "twilio": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yakovsinwani/twilio-realtime-agents.git"
  },
  "bugs": {
    "url": "https://github.com/yakovsinwani/twilio-realtime-agents/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@google/genai": "^2.15.0",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.5",
    "twilio": "^6.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "unrun": "^0.3.1",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
